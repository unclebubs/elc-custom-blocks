{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/news-carousel",
	"version": "0.1.0",
	"title": "News Carousel",
	"category": "widgets",
	"icon": "slides",
	"description": "Display news articles from a category in a Slick Slider carousel.",
	"example": {},
	"attributes": {
		"categoryId": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "news-carousel",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}